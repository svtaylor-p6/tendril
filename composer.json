{
    "name": "johannez/tendril",
    "description": "Wordpress library based on Timber.",
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/johannez/tendril",
    "authors": [
        {
            "name": "Johannes Schmidt",
            "email": "mail@johannez.com"
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "timber/timber": "1.24.1"
    },
    "autoload": {
        "psr-4": {
            "Tendril\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "scripts": {
        "theme": "Tendril\\Composer\\Scripts::installTheme"
    }
}
